# ============================================================
# ROOT .gitignore — Protects the entire CloudDrive-2.0 repo
# ============================================================

# --- Environment files (NEVER commit secrets) ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
**/.env
**/.env.local

# --- Node / Package managers ---
node_modules/
**/node_modules/

# --- Build outputs ---
dist/
build/
.vite/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- OS generated ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editor configs ---
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Coverage / Test outputs ---
coverage/
.nyc_output/

# --- Misc ---
*.tgz
*.lock

